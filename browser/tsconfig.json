{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noImplicitReturns": true,
    "noEmitOnError": true, "declaration": true, "skipLibCheck": false,
    "rootDir": ".", "outDir": "../target/browser", "types": []
  },
  "include": ["src/**/*.ts"]
}
