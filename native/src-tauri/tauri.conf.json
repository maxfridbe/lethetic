{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lethetic",
  "version": "26.1030.2",
  "identifier": "io.github.maxfridbe.lethetic",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "main"
      ],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Lethetic LLM harness",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 26103002,
      "minSdkVersion": 26
    },
    "macOS": {
      "bundleVersion": "2610.30.2",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "../../docs/licenses/STTME-MIT.txt": "licenses/STTME-MIT.txt",
      "../../docs/licenses/WHISPER-RS-UNLICENSE.txt": "licenses/WHISPER-RS-UNLICENSE.txt",
      "../../docs/licenses/CPAL-APACHE-2.0.txt": "licenses/CPAL-APACHE-2.0.txt",
      "../../docs/licenses/WHISPER-CPP-MIT.txt": "licenses/WHISPER-CPP-MIT.txt"
    }
  }
}
